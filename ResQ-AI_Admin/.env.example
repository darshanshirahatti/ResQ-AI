# Copy this file to ".env" and fill in your real values.
# IMPORTANT: Never commit the real .env to source control.

# --- Gmail SMTP sender (used to SEND location emails from the admin dashboard) ---
# Your Gmail address
GMAIL_USER=darshanshirahatti07@gmail.com
# 16-character App Password (https://myaccount.google.com/apppasswords). No spaces.
GMAIL_APP_PASSWORD=vsqlwoqdfnlzioce

# --- Gmail API (OAuth) - used to READ the admin inbox and ACCEPT requests ---
# The OAuth client JSON file downloaded from Google Cloud Console.
# Download for "Desktop app" -> save as client_secret.json in this folder.
GMAIL_CLIENT_SECRET_FILE=client_secret.json
# Where the OAuth token is cached after first authorization.
GMAIL_TOKEN_FILE=token.json

# --- Optional: Gemini API key for AI location insights ---
GEMINI_API_KEY=AIzaSyB2Ogca9tgWp9Q1kJrFGNkI7qHWLCVuPrw
